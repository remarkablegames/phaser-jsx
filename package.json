{
  "name": "phaser-jsx",
  "version": "1.0.3",
  "description": "Use JSX in Phaser.",
  "author": "Mark <mark@remarkablemark.org>",
  "main": "./cjs/index.js",
  "scripts": {
    "build": "npm run build:cjs && npm run build:umd",
    "build:cjs": "tsc --project tsconfig.build.json",
    "build:umd": "rollup --config rollup.config.mts --failAfterWarnings",
    "build:watch": "tsc --watch",
    "clean": "rm -rf cjs coverage docs umd",
    "docs": "typedoc",
    "docs:watch": "npm run docs -- --watch",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "lint:package": "publint",
    "lint:tsc": "tsc --project tsconfig.test.json",
    "lint:types": "npx @arethetypeswrong/cli --pack",
    "prepare": "husky",
    "prepublishOnly": "npm run clean && npm run build && npm run lint && npm run lint:tsc && npm run test:ci",
    "test": "vitest run",
    "test:ci": "CI=true npm test",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remarkablegames/phaser-jsx.git"
  },
  "bugs": {
    "url": "https://github.com/remarkablegames/phaser-jsx/issues"
  },
  "keywords": [
    "phaser-jsx",
    "phaser",
    "jsx",
    "react",
    "ui",
    "view",
    "library",
    "game"
  ],
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-terser": "1.0.2",
    "@rollup/plugin-typescript": "12.3.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-tsdoc": "0.5.4",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.1",
    "phaser": "4.2.1",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "react": "19.3.1",
    "rollup": "4.68.7",
    "tslib": "2.9.1",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0",
    "vitest-canvas-mock": "1.2.0"
  },
  "peerDependencies": {
    "@types/react": "17 || 18 || 19",
    "phaser": "4",
    "react": "17 || 18 || 19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "files": [
    "cjs/",
    "jsx-dev-runtime/",
    "jsx-runtime/",
    "src/",
    "umd/"
  ],
  "license": "MIT"
}
