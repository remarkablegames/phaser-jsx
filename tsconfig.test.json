{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["dom", "es2017", "scripthost"],
    "types": ["node", "vitest/globals"],
    "rootDir": ".",
    "allowJs": true,
    "noEmit": true
  },
  "include": ["__tests__", "src", "jsx-runtime", "jsx-dev-runtime", "*.mts"],
  "exclude": ["node_modules", "cjs", "coverage", "umd"]
}
